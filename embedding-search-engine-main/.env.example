# .env.example — copy to .env for local development (never commit .env)
#
# When running in ECS Fargate, AWS credentials are supplied automatically
# by the ECS task IAM role.  Do NOT put real credentials here.

# AWS region for Amazon Bedrock.
# If left blank, boto3 will detect the region automatically from the
# ECS task metadata endpoint.
AWS_REGION=

# Bedrock embedding model ID.
BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0

# Flask listen port (default: 5000).
PORT=5000
